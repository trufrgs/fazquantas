# Cloudflare Pages: cabeçalhos das respostas.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

# O que diz qual é a versão nunca fica em cache (senão a aba aberta não descobre a nova).
/sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store

# Arquivos do build com hash no nome: podem ficar no cache para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cartas, avatares e sons: sem isso, cada carta que aparecia perguntava ao servidor de novo (max-age=0)
# e, com internet fraca, demorava a surgir na mesa (relato de 29/09/2026). Uma semana sem perguntar e,
# depois, usa o que tem enquanto confere por trás. O service worker atualiza pela revisão do build.
/cards/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=31536000
/avatars/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=31536000
/sounds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=31536000
/music/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=31536000
