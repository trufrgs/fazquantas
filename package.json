{
  "name": "fodinha",
  "private": true,
  "description": "Faz quantas?: a Fodinha com baralho espanhol e regra gaúcha, contra bots ou com a gurizada online.",
  "license": "MIT",
  "homepage": "https://fazquantas.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trufrgs/fazquantas.git"
  },
  "bugs": {
    "url": "https://github.com/trufrgs/fazquantas/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fodinha/web --filter @fodinha/worker dev",
    "test": "pnpm --filter @fodinha/engine --filter @fodinha/sala --filter @fodinha/worker --filter @fodinha/web test",
    "e2e": "playwright test",
    "build": "pnpm --filter @fodinha/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
